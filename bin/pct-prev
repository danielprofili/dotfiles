PLAYER="${PLAYER:-mpd}"
THRESHOLD="${THRESHOLD:-2}"
 
# Current position in seconds (may be fractional, e.g. "0.482000")
if ! pos=$(playerctl --player="$PLAYER" position 2>/dev/null); then
    echo "pct-prev: could not get position from player '$PLAYER'" >&2
    exit 1
fi
 
# Bash can't compare floats, so let awk do it (exit 0 = true)
if awk -v p="$pos" -v t="$THRESHOLD" 'BEGIN { exit !(p < t) }'; then
    playerctl --player="$PLAYER" previous
else
    playerctl --player="$PLAYER" position 0
fi
 

