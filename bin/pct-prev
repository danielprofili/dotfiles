#!/bin/bash
THRESHOLD="${THRESHOLD:-2}"
 
# Current position in seconds (may be fractional, e.g. "0.482000")
if ! pos=$(playerctl position 2>/dev/null); then
    exit 1
fi
 
result=$(echo "$pos < $THRESHOLD" | bc)
if [ $result -eq 1 ]; then
    playerctl previous
else
    playerctl position 0
fi
 

