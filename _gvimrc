" Colorscheme {{{
" Use dracula if it exists, otherwise jellybeans if it exists, and then
" zellner
try
    colorscheme dracula
catch
    try
        colorscheme jellybeans
    catch
        colorscheme zellner
    endtry
endtry
" }}}
" gvim Fonts and Menus {{{
set guifont=FantasqueSansMono\ Nerd\ Font\ 12,Ubuntu\ Mono:h12,IBM\ Plex\ Mono:h11,Consolas:h11
set guioptions-=m
set guioptions-=T
set guioptions-=r
set guioptions-=L
nnoremap <leader>eg :vs $MYGVIMRC<CR>
nnoremap <leader>sg :so $MYGVIMRC<CR>
nnoremap <leader>sv :so $MYVIMRC<CR>:so $MYGVIMRC<CR>
" Note - setting colorscheme overrides this, so it has to be done last
hi CursorLine gui=bold
